# 复制为 backend/admin/.env 后按需修改（.env 已被 git 忽略）
# 这些变量同时供 compose.yaml 与 Spring 应用使用

# ---- 数据库（prod profile 必填，dev 用 H2 时可不填）----
DB_NAME=admin_db
DB_USERNAME=admin
DB_PASSWORD=
DB_URL=jdbc:postgresql://127.0.0.1:15432/admin_db

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0

# ---- JWT（prod profile 必填；admin 与 workflow 两个应用必须一致）----
# 生成方式：
#   openssl rand 192 | base64 | tr -d '\n'   # JWT_SECRET，需 >= 256 字符
#   openssl rand 384 | base64 | tr -d '\n'   # JWT_SECRET_REFRESH，需 >= 512 字符
JWT_SECRET=
JWT_SECRET_REFRESH=
