# ========= Build Native Image =========
FROM ghcr.io/graalvm/native-image-community:21 AS build

WORKDIR /app

COPY . .

RUN chmod +x gradlew

RUN ./gradlew :backend:admin:nativeCompile --no-daemon

# ========= Runtime =========
FROM debian:bookworm-slim

WORKDIR /app

COPY --from=build \
    /app/backend/admin/build/native/nativeCompile/admin \
    /app/admin

EXPOSE 8080

CMD ["./admin"]