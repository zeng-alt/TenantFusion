# =========================
# 1. Build Stage (Native Compile)
# =========================
FROM ghcr.io/graalvm/native-image-community:21 AS build

WORKDIR /app

# 安装基础工具（Gradle需要）
RUN microdnf install -y findutils tar gzip unzip

# 复制项目
COPY . .

# 赋权 gradlew
RUN chmod +x gradlew

# 构建 native
RUN ./gradlew :backend:admin:nativeCompile --no-daemon


# =========================
# 2. Runtime Stage (极简运行环境)
# =========================
FROM debian:bookworm-slim

WORKDIR /app

# TLS / HTTPS 必备
RUN apt-get update && \
    apt-get install -y ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# 拷贝 native 可执行文件
COPY --from=build \
    /app/backend/admin/build/native/nativeCompile/admin \
    /app/app

# Render 必须监听 8080
ENV PORT=8080

EXPOSE 8080

# 启动
ENTRYPOINT ["./app"]